# Copy to private/config.env and fill in real values.
# private/config.env is git-ignored. Never commit real values.

# Supabase (Postgres + Auth + Storage, Mumbai region)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Email OTP (Brevo)
BREVO_API_KEY=

# SMS OTP (MSG91), behind a provider interface
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=

# Payments (Cashfree)
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_ENV=

# AI drafting and review. Use ANTHROPIC_API_KEY or OPENROUTER_API_KEY.
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
CLAUDE_DRAFT_MODEL=
CLAUDE_REVIEW_MODEL=

# Error monitoring (Sentry). NEXT_PUBLIC_SENTRY_DSN is needed for browser-side reporting.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# Webinar integration
WEBINAR_GG_API_TOKEN=
